# ─────────────────────────────────────────────
# MIRYEO K-Beauty Growth AX — 환경변수
# ─────────────────────────────────────────────

# Data Mode: demo(기본, 시연용 Seed + 브라우저 저장) | live(Supabase만 사용, Demo fallback 없음)
NEXT_PUBLIC_DATA_MODE=demo

# Live 모드 필수 — Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live 모드 Customer Platform(비로그인) 이벤트 기록 대상 조직 ID (organizations.id)
NEXT_PUBLIC_MIRYEO_ORG_ID=

# (선택, 서버 전용) 앱 내 구성원 초대(/api/org/members)에 사용 — 절대 NEXT_PUBLIC_ 접두사로 노출하지 않는다
# 없으면 구성원 추가는 SETUP.md §C의 SQL로 한다
# SUPABASE_SERVICE_ROLE_KEY=

# (CONDITIONAL) LLM 요약 기능이 승인되면 추가
# ANTHROPIC_API_KEY=
